<?xml version="1.0"?>
<ruleset name="HyxRender">
  <description>HyxRender coding standard: WordPress, PSR-4 friendly, PHP 8.1 floor.</description>

  <file>plugin</file>
  <arg name="extensions" value="php"/>
  <exclude-pattern>plugin/node_modules/*</exclude-pattern>
  <exclude-pattern>plugin/build/*</exclude-pattern>

  <config name="testVersion" value="8.1-"/>
  <config name="minimum_wp_version" value="6.9"/>

  <rule ref="WordPress">
    <!-- PSR-4 class files (src/Plugin.php) instead of WordPress class-*.php names -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>

  <rule ref="PHPCompatibility"/>
</ruleset>
