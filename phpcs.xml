<?xml version="1.0"?>
<ruleset name="HyxRender">
  <description>HyxRender coding standard: WordPress, PSR-4 friendly.</description>

  <file>plugin</file>
  <arg name="extensions" value="php"/>

  <rule ref="WordPress">
    <!-- PSR-4 class files (src/Plugin.php) instead of WordPress class-*.php names -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>
</ruleset>
