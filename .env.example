# WordPress / Bedrock
DB_NAME=wordpress
DB_USER=wp
DB_PASSWORD=dev_password_change_me
DB_HOST=db
# DB_PREFIX=wp_

# Integration test database, created and granted to DB_USER by `composer test`
WP_TESTS_DB_NAME=wordpress_test

# Only used by docker-compose for the database container
MYSQL_ROOT_PASSWORD=dev_root_change_me

# Fallback if direnv is not loaded; .envrc exports the real values
COMPOSER_UID=1000
COMPOSER_GID=1000

WP_PORT=8080
WP_ENV=development
WP_HOME=http://localhost:8080
WP_SITEURL=${WP_HOME}/wp

# debug = step debugging, off = full speed when you do not need it
XDEBUG_MODE=debug

# Local admin created by wp core install
WP_TITLE='HyxRender Dev'
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Generate real ones per install, e.g. https://roots.io/salts.html
AUTH_KEY=generateme
SECURE_AUTH_KEY=generateme
LOGGED_IN_KEY=generateme
NONCE_KEY=generateme
AUTH_SALT=generateme
SECURE_AUTH_SALT=generateme
LOGGED_IN_SALT=generateme
NONCE_SALT=generateme
