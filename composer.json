{
  "name": "hyx/hyxrender-site",
  "type": "project",
  "license": "MIT",
  "description": "HyxRender dev site: Bedrock-style WordPress with composer-managed plugins",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "hyx/hyx-render": "*",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^6.0 || ^7.0",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wpackagist-plugin/query-monitor": "*",
    "wpackagist-theme/generatepress": "^3.6",
    "wpackagist-theme/twentytwentyfive": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "plugin",
      "options": {
        "symlink": true,
        "versions": {
          "hyx/hyx-render": "dev-master"
        },
        "reference": "config"
      }
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.3"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "humanmade/psalm-plugin-wordpress": "^3.1",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "vimeo/psalm": "^6.5",
    "wp-coding-standards/wpcs": "^3.0",
    "wp-phpunit/wp-phpunit": "^7.1",
    "wpackagist-plugin/elementor": "^4.3",
    "yoast/wp-test-utils": "^1.2"
  },
  "autoload-dev": {
    "psr-4": {
      "Hyx\\Render\\Tests\\": "plugin/tests/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml plugin",
    "lint:fix": "phpcbf --standard=phpcs.xml plugin",
    "lint:mago": "mago lint plugin",
    "analyze": "psalm --no-cache --taint-analysis",
    "test": [
      "@php docker/phpunit/provision-test-db.php",
      "phpunit"
    ],
    "check": [
      "@lint",
      "@lint:mago",
      "@analyze",
      "@test",
      "@composer audit --no-interaction"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the WordPress integration test suite against the test database"
  }
}
