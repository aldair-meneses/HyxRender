{
  "name": "hyx/hyx-render",
  "description": "HyxRender plugin (local development package, symlinked into WordPress)",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Hyx\\Render\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hyx\\Render\\Tests\\": "tests/"
    }
  }
}
